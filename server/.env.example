
# Backend server port
# Example: 5000
PORT=

# Environment mode
# Use: development or production
NODE_ENV=

# Allowed frontend origins, comma-separated
# Example:
# http://localhost:5173,http://localhost:5174
CLIENT_URL=

# Public backend URL
# Example:
# http://localhost:5000
SERVER_URL=


# ---------------------------------------------------------
# MYSQL DATABASE
# ---------------------------------------------------------

# MySQL host
# Example: localhost
MYSQL_HOST=

# MySQL port
# Usually: 3306
MYSQL_PORT=

# MySQL username
# Example: root
MYSQL_USER=

# MySQL password
MYSQL_PASSWORD=

# MySQL database name
# Example: ayosons
MYSQL_DATABASE=


# ---------------------------------------------------------
# GMAIL / EMAIL
# ---------------------------------------------------------

# Gmail account used by AYOSONS to send emails
# Example: yourbusiness@gmail.com
GMAIL_USER=

# Google App Password
# IMPORTANT:
# Do not use your normal Gmail password.
#
# To create it:
# 1. Open your Google Account
# 2. Go to Security
# 3. Enable 2-Step Verification
# 4. Open App passwords
# 5. Create an app password named "AYOSONS Website"
# 6. Copy the generated 16-character password
# 7. Paste it below
GMAIL_APP_PASSWORD=


# ---------------------------------------------------------
# SMTP SETTINGS
# ---------------------------------------------------------

# SMTP server hostname
# For Gmail:
# smtp.gmail.com
SMTP_HOST=

# SMTP port
# Recommended for Gmail STARTTLS:
# 587
SMTP_PORT=

# SMTP secure mode
# Use false with port 587
# Use true with port 465
SMTP_SECURE=

# Optional alternate SMTP credentials
# Leave blank if using GMAIL_USER and GMAIL_APP_PASSWORD
SMTP_USER=
SMTP_PASS=


-----------------------------------------------
# ADMIN ACCOUNT
# ---------------------------------------------------------

# Admin display name
ADMIN_NAME=

# Admin login email
ADMIN_EMAIL=

# Admin login password
# Use a strong password in production
ADMIN_PASSWORD=


# ---------------------------------------------------------
# JWT / AUTHENTICATION
# ---------------------------------------------------------

# Strong random secret used to sign admin authentication tokens
# Never expose this publicly
JWT_SECRET=

# JWT expiry duration
# Example: 1d
JWT_EXPIRES_IN=